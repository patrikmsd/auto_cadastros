  <diagram id="fluxo-demo" name="Fluxo do demo.py">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1260" pageHeight="1800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- título -->
        <mxCell id="titulo" value="&lt;b style=&quot;font-size:20px&quot;&gt;Robô de Cadastro · o que acontece quando rodo o demo.py&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#555&quot;&gt;py demo.py [opções] · produção só leitura · o único card que pode ser gravado é o de teste 62qVR7BlEy&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="180" y="10" width="900" height="50" as="geometry" />
        </mxCell>

        <!-- ===== fluxo principal ===== -->
        <mxCell id="n0" value="&lt;b&gt;py demo.py&lt;/b&gt; [opções]&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;sem --codigo: card de teste 62qVR7BlEy&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="380" y="80" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n1" value="&lt;b&gt;1. Abre o PowerCRM&lt;/b&gt;&lt;br&gt;sessão salva · liga a trava SÓ LEITURA&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;sessão expirada → espera o login na janela&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="370" y="170" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="&lt;b&gt;2. Acha o card&lt;/b&gt;&lt;br&gt;digita o código (ou placa) no Buscar do funil" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="370" y="270" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="Card tem tag&lt;br&gt;de analista?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="420" y="360" width="160" height="90" as="geometry" />
        </mxCell>
        <mxCell id="pare" value="&lt;b&gt;Para&lt;/b&gt;&lt;br&gt;não abre o card" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="660" y="375" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="&lt;b&gt;3. Lê o card e baixa as fotos&lt;/b&gt;&lt;br&gt;abas Contato, Cotações, Vistoria + anexos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="370" y="480" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;4. OCR local dos documentos&lt;/b&gt;&lt;br&gt;CRLV, CNH, comprovante, chassi&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;nada sai do computador · grátis&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="370" y="570" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n4b" value="&lt;b&gt;4b. IA olha as fotos do veículo&lt;/b&gt;&lt;br&gt;modelo, placa, painel/km, vidros, avarias, foto errada ou escura" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="370" y="670" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n4c" value="&lt;b&gt;4c. FIPE oficial (obrigatória)&lt;/b&gt;&lt;br&gt;tabela do mês da cotação · pelo código ou pelo modelo mais próximo · IA decide a versão" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="370" y="770" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;5. IA decide a tabela do CRM&lt;/b&gt;&lt;br&gt;regras + tabela de aceitação (só dados do veículo)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="370" y="870" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n5b" value="&lt;b&gt;5b. IA compara documentos × card&lt;/b&gt;&lt;br&gt;texto do OCR, sem nome e CPF" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="370" y="960" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="&lt;b&gt;6. Conferência por código&lt;/b&gt;&lt;br&gt;cota, valor × FIPE, mensalidade, vencimento, fotos obrigatórias…" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="370" y="1050" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n7" value="&lt;b&gt;7. Veredito&lt;/b&gt;&lt;br&gt;✅ OK · ⚠️ VERIFICAR · ❌ DIVERGENTE&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;nada foi alterado no CRM&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="370" y="1140" width="260" height="70" as="geometry" />
