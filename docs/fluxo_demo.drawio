        <!-- ===== legenda e lote ===== -->
        <mxCell id="legenda" value="&lt;b&gt;Legenda&lt;/b&gt;&lt;br&gt;🟦 navegador / PowerCRM (só leitura)&lt;br&gt;🟩 roda no computador, grátis&lt;br&gt;🟪 IA gpt-6-luna (custa ~R$ 0,06–0,15 por card)&lt;br&gt;🟧 grava no CRM (só card de teste)&lt;br&gt;🟥 parada de segurança&lt;br&gt;🟨 opção na linha de comando" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="1710" width="330" height="130" as="geometry" />
        </mxCell>
        <mxCell id="lote" value="&lt;b&gt;Vários cards de uma vez: py -m robo.lote&lt;/b&gt;&lt;br&gt;lista o funil com o filtro das analistas, pula card com analista&lt;br&gt;e faz as etapas 3 a 7 em cada um · &lt;b&gt;nunca preenche&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;--so-listar · --max 5 · --codigo · --sem-fotos-ia · --retomar &amp;lt;pasta&amp;gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="400" y="1720" width="460" height="95" as="geometry" />
        </mxCell>
        <mxCell id="trava" value="&lt;b&gt;🔒 Trava&lt;/b&gt;&lt;br&gt;Qualquer gravação no CRM é cancelada,&lt;br&gt;exceto Salvar com --gravar no card de teste." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="900" y="1720" width="300" height="80" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
