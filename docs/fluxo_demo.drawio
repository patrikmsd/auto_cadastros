        <mxCell id="n8" value="&lt;b&gt;8. Preenche o card&lt;/b&gt;&lt;br&gt;campos vazios com CRLV, CNH e comprovante&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;só no card de teste 62qVR7BlEy&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
