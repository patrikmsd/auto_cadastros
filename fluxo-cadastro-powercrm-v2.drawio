value="&lt;b&gt;24&lt;/b&gt; · Estado e cidade de circulação → tabela de preço" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F5E5A;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="f72"><mxGeometry x="20" y="1026" width="220" height="46" as="geometry"/></mxCell><mxCell id="f113" value="DENTRO = Goiânia e região metropolitana · FORA = demais" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#633806;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="f72"><mxGeometry x="260" y="1026" width="260" height="46" as="geometry"/></mxCell><mxCell id="f114" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888780;" edge="1" parent="f72" source="f112" target="f113"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f115" value="SP FORA: +R$20 em motos · SP2 FORA: +R$10 (exceto caminhão) · Ribeirão Preto, Pernambuco, Dourados: regras próprias" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#633806;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="f72"><mxGeometry x="260" y="1082" width="260" height="61" as="geometry"/></mxCell><mxCell id="f116" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888780;" edge="1" parent="f72" source="f112" target="f115"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f117" value="Lista de cidades da região metropolitana de Goiânia" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#F3E8FF;strokeColor=#7F77DD;fontColor=#3C3489;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="f72"><mxGeometry x="260" y="1153" width="260" height="46" as="geometry"/></mxCell><mxCell id="f118" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888780;" edge="1" parent="f72" source="f112" target="f117"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f119" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444441;" edge="1" parent="f72" source="f106" target="f112"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f120" value="&lt;b&gt;25&lt;/b&gt; · Implementos (agregado)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F5E5A;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="f72"><mxGeometry x="20" y="1223" width="220" height="46" as="geometry"/></mxCell><mxCell id="f121" value="Cavalo + agregado &gt; R$150 mil → rastreador obrigatório (+R$35). Não aceitos: tanque inox, cegonha, câmara fria, silo em alumínio. Taxa de risco R$350/R$750" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#633806;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="f72"><mxGeometry x="260" y="1223" width="260" height="76" as="geometry"/></mxCell><mxCell id="f122" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888780;" edge="1" parent="f72" source="f120" target="f121"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f123" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444441;" edge="1" parent="f72" source="f112" target="f120"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f124" value="&lt;b&gt;26&lt;/b&gt; · Planos: mensalidade, filiação, rastreador e cota de participação" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F5E5A;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="f72"><mxGeometry x="20" y="1323" width="220" height="61" as="geometry"/></mxCell><mxCell id="f125" value="Mensalidade = tabela Dentro/Fora por tipo + plano (Ouro/Prata/Bronze) + faixa de valor (ou cilindrada nas motos)" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#633806;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="f72"><mxGeometry x="260" y="1323" width="260" height="61" as="geometry"/></mxCell><mxCell id="f126" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888780;" edge="1" parent="f72" source="f124" target="f125"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f127" value="Rastreador: motos &gt; 501cc, motos especiais &gt; R$30 mil, leves/pick-up/caminhão &gt; R$150 mil" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#633806;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="f72"><mxGeometry x="260" y="1394" width="260" height="61" as="geometry"/></mxCell><mxCell id="f128" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888780;" edge="1" parent="f72" source="f124" target="f127"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f129" value="Consultoria e desconto não podem juntos (exceções regionais no DOC)" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#633806;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="f72"><mxGeometry x="260" y="1465" width="260" height="46" as="geometry"/></mxCell><mxCell id="f130" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888780;" edge="1" parent="f72" source="f124" target="f129"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f131" value="Moto CG 150 fora de Goiânia: card R$111,15 / 96,15 / 86,15 × tabela R$106,15 / 91,15 / 81,15 (+R$5 em todos os planos)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#F3E8FF;strokeColor=#7F77DD;fontColor=#3C3489;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="f72"><mxGeometry x="260" y="1521" width="260" height="76" as="geometry"/></mxCell><mxCell id="f132" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888780;" edge="1" parent="f72" source="f124" target="f131"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f133" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444441;" edge="1" parent="f72" source="f120" target="f124"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f134" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444441;" edge="1" parent="1" source="f67" target="f73"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f135" value="5. Vistoria" style="swimlane;startSize=36;fillColor=#E6F1FB;strokeColor=#185FA5;fontColor=#0C447C;fontStyle=1;fontSize=14;rounded=1;arcSize=4;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="2360" y="40" width="540" height="394" as="geometry"/></mxCell><mxCell id="f136" value="&lt;b&gt;27&lt;/b&gt; · Aba &quot;Vistoria&quot;: status e &quot;Visualizar fotos&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F5E5A;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="f135"><mxGeometry x="20" y="56" width="220" height="46" as="geometry"/></mxCell><mxCell id="f137" value="Documentos do card: Termo de Adesão e laudo. CNH, CRLV e comprovante costumam estar nas fotos" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#633806;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="f135"><mxGeometry x="260" y="56" width="260" height="61" as="geometry"/></mxCell><mxCell id="f138" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888780;" edge="1" parent="f135" source="f136" target="f137"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f139" value="&lt;b&gt;28&lt;/b&gt; · Conferir fotos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F5E5A;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="f135"><mxGeometry x="20" y="141" width="220" height="44" as="geometry"/></mxCell><mxCell id="f140" value="Frente, laterais, traseira, motor/km, chassi gravado. Avarias pré-existentes: registrar só periféricos" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#633806;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="f135"><mxGeometry x="260" y="141" width="260" height="61" as="geometry"/></mxCell><mxCell id="f141" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888780;" edge="1" parent="f135" source="f139" target="f140"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f142" value="Assinatura igual à CNH/RG; se divergente, a vistoria precisa de selfie" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#633806;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="f135"><mxGeometry x="260" y="212" width="260" height="46" as="geometry"/></mxCell><mxCell id="f143" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888780;" edge="1" parent="f135" source="f139" target="f142"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f144" value="Critério de aceite das fotos (qualidade mínima)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#F3E8FF;strokeColor=#7F77DD;fontColor=#3C3489;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="f135"><mxGeometry x="260" y="268" width="260" height="46" as="geometry"/></mxCell><mxCell id="f145" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888780;" edge="1" parent="f135" source="f139" target="f144"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f146" value="Checklist automático de fotos obrigatórias + OCR do chassi comparado ao CRLV" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3DE;strokeColor=#3B6D11;fontColor=#27500A;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="f135"><mxGeometry x="260" y="324" width="260" height="46" as="geometry"/></mxCell><mxCell id="f147" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888780;" edge="1" parent="f135" source="f139" target="f146"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f148" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444441;" edge="1" parent="f135" source="f136" target="f139"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f149" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444441;" edge="1" parent="1" source="f124" target="f136"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f150" value="6. Decisão (analista)" style="swimlane;startSize=36;fillColor=#E6F1FB;strokeColor=#185FA5;fontColor=#0C447C;fontStyle=1;fontSize=14;rounded=1;arcSize=4;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="2940" y="40" width="540" height="560" as="geometry"/></mxCell><mxCell id="f151" value="Cadastro ok?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F5E5A;fontSize=12;fontStyle=1;" vertex="1" parent="f150"><mxGeometry x="170" y="60" width="200" height="100" as="geometry"/></mxCell><mxCell id="f152" value="&lt;b&gt;29&lt;/b&gt; · Aprovar (botão na aba Vistoria) → exportar ao SGA com a classificação: Nova adesão, Troca de placa, Reativação ou Troca de titularidade" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F5E5A;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="f150"><mxGeometry x="20" y="210" width="230" height="100" as="geometry"/></mxCell><mxCell id="f153" value="&lt;b&gt;30&lt;/b&gt; · Reprovar → motivo padrão do CRM: Falta contrato, Falta vistoria, Falta documentação, Falta rastreador, Fotos da vistoria ruins, Foto do chassi ilegível" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCEBEB;strokeColor=#A32D2D;fontColor=#791F1F;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="f150"><mxGeometry x="290" y="210" width="230" height="100" as="geometry"/></mxCell><mxCell id="f154" value="Sim" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444441;" edge="1" parent="f150" source="f151" target="f152"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f155" value="Não" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444441;" edge="1" parent="f150" source="f151" target="f153"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f156" value="Fase futura: Aprovar com pendência leve (SGA + planilha) e Retornar ao consultor (Atividades + planilha Retornadas)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#F1EFE8;strokeColor=#888780;fontColor=#5F5E5A;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="f150"><mxGeometry x="20" y="340" width="500" height="56" as="geometry"/></mxCell><mxCell id="f157" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888780;" edge="1" parent="f150" source="f151" target="f156"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f158" value="Nesta fase o robô NÃO aprova nem reprova: gera o relatório de validação e a analista decide" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3DE;strokeColor=#3B6D11;fontColor=#27500A;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="f150"><mxGeometry x="20" y="420" width="500" height="50" as="geometry"/></mxCell><mxCell id="f159" value="Botões Salvar, Aprovar, Reprovar, Cancelar e planos alteram dados com 1 clique: o robô não clica" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCEBEB;strokeColor=#A32D2D;fontColor=#791F1F;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="f150"><mxGeometry x="20" y="490" width="500" height="50" as="geometry"/></mxCell><mxCell id="f160" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444441;" edge="1" parent="1" source="f139" target="f151"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="a" name="2. Arquitetura da automação"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="a1" value="Arquitetura da automação – o que usar em cada etapa" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#0C447C;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="-60" width="900" height="30" as="geometry"/></mxCell><mxCell id="a2" value="Agendador" style="swimlane;startSize=36;fillColor=#E6F1FB;strokeColor=#185FA5;fontColor=#0C447C;fontStyle=1;fontSize=14;rounded=1;arcSize=4;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="270" height="230" as="geometry"/></mxCell><mxCell id="a3" value="Task Scheduler do Windows a cada X min. Reprocessa só card novo ou alterado (ID + hash)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F5E5A;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="a2"><mxGeometry x="15" y="50" width="240" height="165" as="geometry"/></mxCell><mxCell id="a4" value="Coleta – Playwright (Python)" style="swimlane;startSize=36;fillColor=#E6F1FB;strokeColor=#185FA5;fontColor=#0C447C;fontStyle=1;fontSize=14;rounded=1;arcSize=4;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="340" y="40" width="270" height="230" as="geometry"/></mxCell><mxCell id="a5" value="Login com sessão salva · filtro (URL + selo 5) · lista da coluna Vistorias · pula nomes de analista · lê os dados pelas respostas da API (page.on(&quot;response&quot;)) · baixa fotos e PDFs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F5E5A;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="a4"><mxGeometry x="15" y="50" width="240" height="165" as="geometry"/></mxCell><mxCell id="a6" value="Extração de documentos" style="swimlane;startSize=36;fillColor=#E6F1FB;strokeColor=#185FA5;fontColor=#0C447C;fontStyle=1;fontSize=14;rounded=1;arcSize=4;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="640" y="40" width="270" height="230" as="geometry"/></mxCell><mxCell id="a7" value="1º QR Code da CNH-e/CRLV-e (pyzbar) · 2º IA com visão (Claude) classifica o documento e devolve JSON · 3º PaddleOCR para conferir números" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F5E5A;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="a6"><mxGeometry x="15" y="50" width="240" height="165" as="geometry"/></mxCell><mxCell id="a8" value="Validadores de formato" style="swimlane;startSize=36;fillColor=#E6F1FB;strokeColor=#185FA5;fontColor=#0C447C;fontStyle=1;fontSize=14;rounded=1;arcSize=4;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="940" y="40" width="270" height="230" as="geometry"/></mxCell><mxCell id="a9" value="pydantic + regras: dígito do CPF e do Renavam, chassi com 17 caracteres (sem I/O/Q), placa Mercosul/antiga, correções 0↔O, 1↔I" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F5E5A;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="a8"><mxGeometry x="15" y="50" width="240" height="165" as="geometry"/></mxCell><mxCell id="a10" value="Motor de regras (código, sem IA)" style="swimlane;startSize=36;fillColor=#E6F1FB;strokeColor=#185FA5;fontColor=#0C447C;fontStyle=1;fontSize=14;rounded=1;arcSize=4;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1240" y="40" width="270" height="230" as="geometry"/></mxCell><mxCell id="a11" value="Aceitação, preço Dentro/Fora, cota, rastreador, idade, Uber +2%, vencimento 10/25, FIPE = valor protegido, regionais. Comparação de nomes com rapidfuzz" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F5E5A;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="a10"><mxGeometry x="15" y="50" width="240" height="165" as="geometry"/></mxCell><mxCell id="a12" value="Banco de dados" style="swimlane;startSize=36;fillColor=#E6F1FB;strokeColor=#185FA5;fontColor=#0C447C;fontStyle=1;fontSize=14;rounded=1;arcSize=4;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1540" y="40" width="270" height="230" as="geometry"/></mxCell><mxCell id="a13" value="SQLite → PostgreSQL. Tabelas: cards, snapshots (JSON bruto), documentos, extracoes, tabela_aceitacao, tabela_precos (com vigência), regras, validacoes, execucoes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F5E5A;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="a12"><mxGeometry x="15" y="50" width="240" height="165" as="geometry"/></mxCell><mxCell id="a14" value="Relatório para a analista" style="swimlane;startSize=36;fillColor=#E6F1FB;strokeColor=#185FA5;fontColor=#0C447C;fontStyle=1;fontSize=14;rounded=1;arcSize=4;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1840" y="40" width="270" height="230" as="geometry"/></mxCell><mxCell id="a15" value="Por card: ✅ OK / ❌ divergente (esperado × encontrado) / ⚠️ não verificável. A decisão continua com a analista" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F5E5A;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="a14"><mxGeometry x="15" y="50" width="240" height="165" as="geometry"/></mxCell><mxCell id="a16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444441;" edge="1" parent="1" source="a2" target="a4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444441;" edge="1" parent="1" source="a4" target="a6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444441;" edge="1" parent="1" source="a6" target="a8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444441;" edge="1" parent="1" source="a8" target="a10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444441;" edge="1" parent="1" source="a10" target="a12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444441;" edge="1" parent="1" source="a12" target="a14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a22" value="Base de tabelas (CSV conferido por pessoa): Tabela de Aceitação 22/05/2026 · Tabela Dentro · Tabela Fora · regras do DOC (regionais, campanhas) com data de início e fim de vigência" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#633806;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="940" y="330" width="520" height="70" as="geometry"/></mxCell><mxCell id="a23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444441;" edge="1" parent="1" source="a22" target="a10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a24" value="Proteção: page.route cancela qualquer POST/PUT/DELETE para o powercrm. Mesmo um clique errado não grava nada" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCEBEB;strokeColor=#A32D2D;fontColor=#791F1F;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="340" y="330" width="520" height="60" as="geometry"/></mxCell><mxCell id="a25" value="IA SIM: ler documentos e fotos, classificar o tipo de documento, comparar nomes de modelo diferentes, escrever o resumo das divergências" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3DE;strokeColor=#3B6D11;fontColor=#27500A;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="620" height="50" as="geometry"/></mxCell><mxCell id="a26" value="IA NÃO: calcular mensalidade, cota, faixa de valor e prazos (isso é código determinístico e rastreável até a linha da tabela)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCEBEB;strokeColor=#A32D2D;fontColor=#791F1F;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="700" y="450" width="620" height="50" as="geometry"/></mxCell><mxCell id="a27" value="LGPD: CNH, CPF e fotos só no seu servidor, criptografados, com prazo de retenção. Provedor de IA com contrato que não treina com os dados" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#633806;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1360" y="450" width="620" height="50" as="geometry"/></mxCell><mxCell id="a28" value="Ordem de implementação: 1) tabelas em CSV · 2) Playwright só leitura · 3) regras de maior impacto · 4) documentos/OCR · 5) relatório e agendamento" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#F3E8FF;strokeColor=#7F77DD;fontColor=#3C3489;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="1280" height="44" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d" name="3. Divergências a resolver"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="d1" value="Divergências encontradas nos arquivos (a resolver antes de virar regra)" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#0C447C;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="-60" width="1000" height="30" as="geometry"/></mxCell><mxCell id="d2" value="DOC × Tabela de Aceitação" style="swimlane;startSize=36;fillColor=#E6F1FB;strokeColor=#185FA5;fontColor=#0C447C;fontStyle=1;fontSize=14;rounded=1;arcSize=4;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="400" height="394" as="geometry"/></mxCell><mxCell id="d3" value="BYD KING: DOC = Normal · tabela não lista (cai em BYD todos os outros = Flat)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#F3E8FF;strokeColor=#7F77DD;fontColor=#3C3489;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="d2"><mxGeometry x="20" y="50" width="360" height="46" as="geometry"/></mxCell><mxCell id="d4" value="GEELY EX5: DOC = Especial · tabela só lista EX2" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#F3E8FF;strokeColor=#7F77DD;fontColor=#3C3489;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="d2"><mxGeometry x="20" y="106" width="360" height="44" as="geometry"/></mxCell><mxCell id="d5" value="JEEP COMMANDER: DOC = R$10 mais barata sem periféricos · tabela sem essa observação" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#F3E8FF;strokeColor=#7F77DD;fontColor=#3C3489;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="d2"><mxGeometry x="20" y="160" width="360" height="46" as="geometry"/></mxCell><mxCell id="d6" value="Motos Shineray/SBM/Avelloz 50cc sem placa: DOC aceita na Flat · tabela exige moto emplacada" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#F3E8FF;strokeColor=#7F77DD;fontColor=#3C3489;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="d2"><mxGeometry x="20" y="216" width="360" height="46" as="geometry"/></mxCell><mxCell id="d7" value="Mais de 20 anos: p.1 &quot;Flat com autorização&quot; × p.5 &quot;não serão aceitos&quot;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#F3E8FF;strokeColor=#7F77DD;fontColor=#3C3489;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="d2"><mxGeometry x="20" y="272" width="360" height="46" as="geometry"/></mxCell><mxCell id="d8" value="Consultoria + desconto: proibido no geral, permitido no informativo da Diuliane" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#F3E8FF;strokeColor=#7F77DD;fontColor=#3C3489;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="d2"><mxGeometry x="20" y="328" width="360" height="46" as="geometry"/></mxCell><mxCell id="d9" value="Qualidade da Tabela de Aceitação" style="swimlane;startSize=36;fillColor=#E6F1FB;strokeColor=#185FA5;fontColor=#0C447C;fontStyle=1;fontSize=14;rounded