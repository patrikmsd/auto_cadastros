ap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#633806;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="f72"><mxGeometry x="260" y="56" width="260" height="61" as="geometry"/></mxCell><mxCell id="f75" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888780;" edge="1" parent="f72" source="f73" target="f74"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f76" value="Guardar o histórico para auditoria" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3DE;strokeColor=#3B6D11;fontColor=#27500A;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="f72"><mxGeometry x="260" y="127" width="260" height="44" as="geometry"/></mxCell><mxCell id="f77" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888780;" edge="1" parent="f72" source="f73" target="f76"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f78" value="&lt;b&gt;18&lt;/b&gt; · Aba &quot;Contato&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F5E5A;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="f72"><mxGeometry x="20" y="195" width="220" height="44" as="geometry"/></mxCell><mxCell id="f79" value="Dados têm que bater com CNH ou RG (ou carteira profissional) e com o comprovante de endereço (energia, água, internet, NF, contrato de locação)" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#633806;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="f72"><mxGeometry x="260" y="195" width="260" height="76" as="geometry"/></mxCell><mxCell id="f80" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888780;" edge="1" parent="f72" source="f78" target="f79"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f81" value="OCR/IA da CNH/RG comparando com os campos do card" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3DE;strokeColor=#3B6D11;fontColor=#27500A;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="f72"><mxGeometry x="260" y="281" width="260" height="46" as="geometry"/></mxCell><mxCell id="f82" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888780;" edge="1" parent="f72" source="f78" target="f81"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f83" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444441;" edge="1" parent="f72" source="f73" target="f78"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f84" value="&lt;b&gt;19&lt;/b&gt; · Aba &quot;Cotações&quot; → Informações do veículo: placa, chassi, Renavam, marca, modelo, ano modelo/fabricação" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F5E5A;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="f72"><mxGeometry x="20" y="351" width="220" height="76" as="geometry"/></mxCell><mxCell id="f85" value="Têm que bater com o CRLV (ou NF 0 km até 60 dias). CRLV vencido aceito de (ano atual − 3) em diante" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#633806;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="f72"><mxGeometry x="260" y="351" width="260" height="61" as="geometry"/></mxCell><mxCell id="f86" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888780;" edge="1" parent="f72" source="f84" target="f85"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f87" value="Antes: pesquisar CPF no SGA e chassi na SBL (não pode estar ativo/negado em outra associação)" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#633806;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="f72"><mxGeometry x="260" y="422" width="260" height="61" as="geometry"/></mxCell><mxCell id="f88" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888780;" edge="1" parent="f72" source="f84" target="f87"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f89" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444441;" edge="1" parent="f72" source="f78" target="f84"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f90" value="&lt;b&gt;20&lt;/b&gt; · Código / Valor FIPE e Valor protegido" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F5E5A;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="f72"><mxGeometry x="20" y="507" width="220" height="46" as="geometry"/></mxCell><mxCell id="f91" value="FIPE tem que bater com o modelo do documento. Valor protegido = FIPE; depreciação 30% se recuperado de sinistro, chassi remarcado ou leilão" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#633806;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="f72"><mxGeometry x="260" y="507" width="260" height="76" as="geometry"/></mxCell><mxCell id="f92" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888780;" edge="1" parent="f72" source="f90" target="f91"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f93" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444441;" edge="1" parent="f72" source="f84" target="f90"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f94" value="&lt;b&gt;21&lt;/b&gt; · Tabela de aceitação" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F5E5A;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="f72"><mxGeometry x="20" y="607" width="220" height="44" as="geometry"/></mxCell><mxCell id="f95" value="Ordem: buscar MODELO no documento → comparar com a tabela de aceitação → colher TABELA e COTA → validar a cotação" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#633806;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="f72"><mxGeometry x="260" y="607" width="260" height="61" as="geometry"/></mxCell><mxCell id="f96" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888780;" edge="1" parent="f72" source="f94" target="f95"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f97" value="Mais de 20 anos (caminhão 30) só com autorização da diretoria. Blindado não é aceito" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#633806;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="f72"><mxGeometry x="260" y="678" width="260" height="61" as="geometry"/></mxCell><mxCell id="f98" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888780;" edge="1" parent="f72" source="f94" target="f97"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f99" value="Conflitos DOC × tabela (ver página 3)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#F3E8FF;strokeColor=#7F77DD;fontColor=#3C3489;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="f72"><mxGeometry x="260" y="749" width="260" height="44" as="geometry"/></mxCell><mxCell id="f100" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888780;" edge="1" parent="f72" source="f94" target="f99"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f101" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444441;" edge="1" parent="f72" source="f90" target="f94"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f102" value="&lt;b&gt;22&lt;/b&gt; · Dia de vencimento" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F5E5A;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="f72"><mxGeometry x="20" y="817" width="220" height="44" as="geometry"/></mxCell><mxCell id="f103" value="Só 10 ou 25" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#633806;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="f72"><mxGeometry x="260" y="817" width="260" height="44" as="geometry"/></mxCell><mxCell id="f104" value="" style="endArrow=none;dashed=