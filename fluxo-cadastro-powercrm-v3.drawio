ounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F5E5A;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="f8"><mxGeometry x="20" y="197" width="220" height="44" as="geometry"/></mxCell><mxCell id="f15" value="Credenciais no .env (fora do código e do Git). Ideal: usuário só leitura para o robô" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3DE;strokeColor=#3B6D11;fontColor=#27500A;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="f8"><mxGeometry x="260" y="197" width="260" height="61" as="geometry"/></mxCell><mxCell id="f16" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888780;" edge="1" parent="f8" source="f14" target="f15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444441;" edge="1" parent="f8" source="f9" target="f14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f18" value="&lt;b&gt;3&lt;/b&gt; · Clicar em &quot;Acessar&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F5E5A;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="f8"><mxGeometry x="20" y="282" width="220" height="44" as="geometry"/></mxCell><mxCell id="f19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444441;" edge="1" parent="f8" source="f14" target="f18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f20" value="&lt;b&gt;4&lt;/b&gt; · Selecionar a empresa (se o sistema pedir)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F5E5A;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="f8"><mxGeometry x="20" y="350" width="220" height="46" as="geometry"/></mxCell><mxCell id="f21" value="Com sessão já aberta o sistema vai direto ao Dashboard" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#633806;fontSize=11;align=left;spacingLeft=6;" v