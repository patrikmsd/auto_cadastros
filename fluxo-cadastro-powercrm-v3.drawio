<mxfile host="app.diagrams.net"><diagram id="f" name="1. Fluxo de cadastro (v3)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="f1" value="Fluxo de conferência de cadastro – PowerCRM (v3 · 28/10/2026)" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#0C447C;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="-120" width="900" height="30" as="geometry"/></mxCell><mxCell id="f2" value="Passo do fluxo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F5E5A;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="-70" width="200" height="36" as="geometry"/></mxCell><mxCell id="f3" value="Regra definida (DOC / tabelas)" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#633806;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="250" y="-70" width="200" height="36" as="geometry"/></mxCell><mxCell id="f4" value="Regra a definir" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#F3E8FF;strokeColor=#7F77DD;fontColor=#3C3489;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="460" y="-70" width="200" height="36" as="geometry"/></mxCell><mxCell id="f5" value="Ponto de automação" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3DE;strokeColor=#3B6D11;fontColor=#27500A;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="670" y="-70" width="200" height="36" as="geometry"/></mxCell><mxCell id="f6" value="Proteção / não clicar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCEBEB;strokeColor=#A32D2D;fontColor=#791F1F;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="880" y="-70" width="200" height="36" as="geometry"/></mxCell><mxCell id="f7" value="Fase futura (fora do escopo)"