Size=14;rounded=1;arcSize=4;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1200" y="40" width="540" height="438" as="geometry"/></mxCell><mxCell id="f60" value="&lt;b&gt;14&lt;/b&gt; · Ler a coluna &quot;Vistorias&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F5E5A;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="f59"><mxGeometry x="20" y="56" width="220" height="46" as="geometry"/></mxCell><mxCell id="f61" value="Semana 26–28/10: 10 cards, 9 com nome de analista, 1 livre" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#633806;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="f59"><mxGeometry x="260" y="56" width="260" height="46" as="geometry"/></mxCell><mxCell id="f62" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888780;" edge="1" parent="f59" source="f60" target="f61"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f63" value="&lt;b&gt;15&lt;/b&gt; · O card tem tag com NOME de analista?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F5E5A;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="f59"><mxGeometry x="20" y="126" width="220" height="46" as="geometry"/></mxCell><mxCell id="f64" value="Nomes: ESTER, ESTER DIAS, JEFFERSON, PAMMELA, MARIA CLARA, SILVIA, LUANA, CINTIA, THAYNA, HELOISE, BARBARA, CARINA, GEOVANNA, AMANDA, VITORIA, KEITY, NICOLAS, GUILHERME" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#633806;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="f59"><mxGeometry x="260" y="126" width="260" height="91" as="geometry"/></mxCell><mxCell id="f65" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888780;" edge="1" parent="f59" source="f63" target="f64"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f66" value="SIM → não abrir o card (já é de uma analista)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCEBEB;strokeColor=#A32D2D;fontColor=#791F1F;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="f59"><mxGeometry x="260" y="227" width="260" height="46" as="geometry"/></mxCell><mxCell id="f67" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888780;" edge="1" parent="f59" source="f63" target="f66"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f68" value="Lista de nomes guardada no banco para incluir analistas novas sem mexer no código" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3DE;strokeColor=#3B6D11;fontColor=#27500A;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="f59"><mxGeometry x="260" y="283" width="260" height="61" as="geometry"/></mxCell><mxCell id="f69" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888780;" edge="1" parent="f59" source="f63" target="f68"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f70" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444441;" edge="1" parent="f59" source="f60" target="f63"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f71" value="&lt;b&gt;16&lt;/b&gt; · NÃO → abrir o card" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F5E5A;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="f59"><mxGeometry x="20" y="368" width="220" height="44" as="geometry"/></mxCell><mxCell id="f72" value="Nunca clicar em &quot;Atender essa negociação&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCEBEB;strokeColor=#A32D2D;fontColor=#791F1F;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="f59"><mxGeometry x="260" y="368" width="260" height="46" as="geometry"/></mxCell><mxCell id="f73" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888780;" edge="1" parent="f59" source="f71" target="f72"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f74" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444441;" edge="1" parent="f59" source="f63" target="f71"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f75" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444441;" edge="1" parent="1" source="f52" target="f60"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f76" value="4. Conferência do card" style="swimlane;startSize=36;fillColor=#E6F1FB;strokeColor=#185FA5;fontColor=#0C447C;fontStyle=1;fontSize=14;rounded=1;arcSize=4;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1780" y="40" width="540" height="2111" as="geometry"/></mxCell><mxCell id="f77" value="&lt;b&gt;17&lt;/b&gt; · Histórico → Geral" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F5E5A;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="f76"><mxGeometry x="20" y="56" width="220" height="44" as="geometry"/></mxCell><mxCell id="f78" value="Mostra quem alterou campos e tags (ex.: consultor mudou o nome antes de colocar a tag)" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#633806;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="f76"><mxGeometry x="260" y="56" width="260" height="61" as="geometry"/></mxCell><mxCell id="f79" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888780;" edge="1" parent="f76" source="f77" target="f78"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f80" value="Guardar o histórico para auditoria" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3DE;strokeColor=#3B6D11;fontColor=#27500A;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="f76"><mxGeometry x="260" y="127" width="260" height="44" as="geometry"/></mxCell><mxCell id="f81" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888780;" edge="1" parent="f76" source="f77" target="f80"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f82" value="&lt;b&gt;18&lt;/b&gt; · Aba &quot;Contato&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F5E5A;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="f76"><mxGeometry x="20" y="195" width="220" height="44" as="geometry"/></mxCell><mxCell id="f83" value="Dados têm que bater com CNH ou RG (ou carteira profissional) e com o comprovante de endereço (energia, água, internet, NF, contrato de locação)" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#633806;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="f76"><mxGeometry x="260" y="195" width="260" height="76" as="geometry"/></mxCell><mxCell id="f84" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888780;" edge="1" parent="f76" source="f82" target="f83"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f85" value="OCR/IA da CNH/RG comparando com os campos do card" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3DE;strokeColor=#3B6D11;fontColor=#27500A;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="f76"><mxGeometry x="260" y="281" width="260" height="46" as="geometry"/></mxCell><mxCell id="f86" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888780;" edge="1" parent="f76" source="f82" target="f85"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f87" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444441;" edge="1" parent="f76" source="f77" target="f82"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f88" value="&lt;b&gt;19&lt;/b&gt; · Aba &quot;Cotações&quot; → Informações do veículo: placa, chassi, Renavam, marca, modelo, ano modelo/fabricação" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F5E5A;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="f76"><mxGeometry x="20" y="351" width="220" height="76" as="geometry"/></mxCell><mxCell id="f89" value="Têm que bater com o CRLV (ou NF 0 km até 60 dias). CRLV vencido aceito de (ano atual − 3) em diante" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#633806;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="f76"><mxGeometry x="260" y="351" width="260" height="61" as="geometry"/></mxCell><mxCell id="f90" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888780;" edge="1" parent="f76" source="f88" target="f89"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f91" value="Antes: pesquisar CPF no SGA e chassi na SBL (não pode estar ativo/negado em outra associação)" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#633806;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="f76"><mxGeometry x="260" y="422" width="260" height="61" as="geometry"/></mxCell><mxCell id="f92" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888780;" edge="1" parent="f76" source="f88" target="f91"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f93" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444441;" edge="1" parent="f76" source="f82" target="f88"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f94" value="&lt;b&gt;20&lt;/b&gt; · Código / Valor FIPE e Valor protegido" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F5E5A;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="f76"><mxGeometry x="20" y="507" width="220" height="46" as="geometry"/></mxCell><mxCell id="f95" value="FIPE tem que bater com o modelo do documento. Valor protegido = FIPE; depreciação 30% se recuperado de sinistro, chassi remarcado ou leilão" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#633806;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="f76"><mxGeometry x="260" y="507" width="260" height="76" as="geometry"/></mxCell><mxCell id="f96" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888780;" edge="1" parent="f76" source="f94" target="f95"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f97" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444441;" edge="1" parent="f76" source="f88" target="f94"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f98" value="&lt;b&gt;21&lt;/b&gt; · Tabela de aceitação" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F5E5A;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="f76"><mxGeometry x="20" y="607" width="220" height="44" as="geometry"/></mxCell><mxCell id="f99" value="Ordem: buscar MODELO no documento → comparar com a tabela de aceitação → colher TABELA e COTA → validar a cotação" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#633806;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="f76"><mxGeometry x="260" y="607" width="260" height="61" as="geometry"/></mxCell><mxCell id="f100" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888780;" edge="1" parent="f76" source="f98" target="f99"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f101" value="Mais de 20 anos (caminhão 30): FLAT (99) só com print de autorização da diretoria. Blindado não é aceito" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#633806;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="f76"><mxGeometry x="260" y="678" width="260" height="61" as="geometry"/></mxCell><mxCell id="f102" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888780;" edge="1" parent="f76" source="f98" target="f101"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f103" value="Exceções decididas: BYD King = Flat · Geely EX5 = Especial · moto 50cc só emplacada · cilindrada = número do nome do modelo (CG 160 → 151–160cc)" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#633806;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="f76"><mxGeometry x="260" y="749" width="260" height="76" as="geometry"/></mxCell><mxCell id="f104" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888780;" edge="1" parent="f76" source="f98" target="f103"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f105" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444441;" edge="1" parent="f76" source="f94" target="f98"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f106" value="&lt;b&gt;22&lt;/b&gt; · Dia de vencimento" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F5E5A;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="f76"><mxGeometry x="20" y="849" width="220" height="44" as="geometry"/></mxCell><mxCell id="f107" value="Só 10 ou 25" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#633806;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="f76"><mxGeometry x="260" y="849" width="260" height="44" as="geometry"/></mxCell><mxCell id="f108" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888780;" edge="1" parent="f76" source="f106" target="f107"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f109" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444441;" edge="1" parent="f76" source="f98" target="f106"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f110" value="&lt;b&gt;23&lt;/b&gt; · Combustível, Câmbio e &quot;Veículo de trabalho (Táxi/Uber)&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F5E5A;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="f76"><mxGeometry x="20" y="917" width="220" height="61" as="geometry"/></mxCell><mxCell id="f111" value="Combustível e câmbio são obrigatórios (vazio = não verificável). Quilometragem não" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#633806;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="f76"><mxGeometry x="260" y="917" width="260" height="61" as="geometry"/></mxCell><mxCell id="f112" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888780;" edge="1" parent="f76" source="f110" target="f111"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f113" value="Combustível muda a TABELA (diesel → 05/15, híbrido → tabelas HÍBRIDO). Câmbio não muda valor: só confere a versão/FIPE" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#633806;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="f76"><mxGeometry x="260" y="988" width="260" height="76" as="geometry"/></mxCell><mxCell id="f114" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888780;" edge="1" parent="f76" source="f110" target="f113"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f115" value="Táxi/Uber muda a TABELA (03, 20, 21, 22): só a cota muda, a mensalidade não. Caminhão fora" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#633806;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="f76"><mxGeometry x="260" y="1074" width="260" height="61" as="geometry"/></mxCell><mxCell id="f116" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888780;" edge="1" parent="f76" source="f110" target="f115"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f117" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444441;" edge="1" parent="f76" source="f106" target="f110"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f118" value="&lt;b&gt;24&lt;/b&gt; · Estado e cidade de circulação → regional" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F5E5A;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="f76"><mxGeometry x="20" y="1159" width="220" height="46" as="geometry"/></mxCell><mxCell id="f119" value="DENTRO = 21 cidades (Goiânia, Aparecida, Anápolis, Senador Canedo, Trindade… lista completa na planilha). Interior de GO = FORA" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#633806;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="f76"><mxGeometry x="260" y="1159" width="260" height="76" as="geometry"/></mxCell><mxCell id="f120" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888780;" edge="1" parent="f76" source="f118" target="f119"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f121" value="Negar: AC, AP, AM, PA, RO, RR e cidades metropolitanas de SP e RJ não cobertas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCEBEB;strokeColor=#A32D2D;fontColor=#791F1F;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="f76"><mxGeometry x="260" y="1245" width="260" height="46" as="geometry"/></mxCell><mxCell id="f122" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888780;" edge="1" parent="f76" source="f118" target="f121"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f123" value="SP FORA: +R$20 em motos · SP2 FORA: +R$10 (exceto caminhão) · Ribeirão Preto, Pernambuco, Dourados: regras próprias" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#633806;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="f76"><mxGeometry x="260" y="1301" width="260" height="61" as="geometry"/></mxCell><mxCell id="f124" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888780;" edge="1" parent="f76" source="f118" target="f123"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f125" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444441;" edge="1" parent="f76" source="f110" target="f118"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f126" value="&lt;b&gt;25&lt;/b&gt; · Implementos (agregado)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F5E5A;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="f76"><mxGeometry x="20" y="1386" width="220" height="46" as="geometry"/></mxCell><mxCell id="f127" value="Cavalo + agregado &gt; R$150 mil → rastreador obrigatório (+R$35). Não aceitos: tanque inox, cegonha, câmara fria, silo em alumínio. Taxa de risco R$350/R$750" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#633806;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="f76"><mxGeometry x="260" y="1386" width="260" height="76" as="geometry"/></mxCell><mxCell id="f128" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888780;" edge="1" parent="f76" source="f126" target="f127"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f129" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444441;" edge="1" parent="f76" source="f118" target="f126"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f130" value="&lt;b&gt;26&lt;/b&gt; · Planos: tabela escolhida (Cotações → Planos, ex.: &quot;01 - LEVES (5%)&quot;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F5E5A;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="f76"><mxGeometry x="20" y="1486" width="220" height="61" as="geometry"/></mxCell><mxCell id="f131" value="O % já vem na tabela do CRM. Regional + tipo + modelo + uso + combustível + aceitação decidem QUAL tabela (aba ESCOLHA_TABELA)" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#633806;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="f76"><mxGeometry x="260" y="1486" width="260" height="76" as="geometry"/></mxCell><mxCell id="f132" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888780;" edge="1" parent="f76" source="f130" target="f131"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f133" value="Robô compara a tabela esperada com a escolhida. Modo teste: pode trocar a tabela no card falso" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3DE;strokeColor=#3B6D11;fontColor=#27500A;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="f76"><mxGeometry x="260" y="1572" width="260" height="61" as="geometry"/></mxCell><mxCell id="f134" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888780;" edge="1" parent="f76" source="f130" target="f133"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f135" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444441;" edge="1" parent="f76" source="f126" target="f130"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f136" value="&lt;b&gt;27&lt;/b&gt; · Mensalidade e cota de participação" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F5E5A;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="f76"><mxGeometry x="20" y="1657" width="220" height="46" as="geometry"/></mxCell><mxCell id="f137" value="Mensalidade = preço da tabela Dentro/Fora (tipo + plano + faixa de valor, ou cc nas motos) + ajustes dos gestores" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#633806;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="f76"><mxGeometry x="260" y="1657" width="260" height="61" as="geometry"/></mxCell><mxCell id="f138" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888780;" edge="1" parent="f76" source="f136" target="f137"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f139" value="Cota: faixas baratas = valor fixo em R$; depois = % da tabela × valor do veículo. Moto normal R$30–90 mil = 10%. Moto especial = 15%, mín. R$2.000" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#633806;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="f76"><mxGeometry x="260" y="1728" width="260" height="76" as="geometry"/></mxCell><mxCell id="f140" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888780;" edge="1" parent="f76" source="f136" target="f139"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f141" value="Rastreador: motos &gt; 501cc, motos especiais &gt; R$30 mil, leves/pick-up/caminhão &gt; R$150 mil" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#633806;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="f76"><mxGeometry x="260" y="1814" width="260" height="61" as="geometry"/></mxCell><mxCell id="f142" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888780;" edge="1" parent="f76" source="f136" target="f141"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f143" value="Filiação não é conferida. Consultoria e desconto não podem juntos (exceções regionais no DOC)" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#633806;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="f76"><mxGeometry x="260" y="1885" width="260" height="61" as="geometry"/></mxCell><mxCell id="f144" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888780;" edge="1" parent="f76" source="f136" target="f143"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f145" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444441;" edge="1" parent="f76" source="f130" target="f136"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f146" value="&lt;b&gt;28&lt;/b&gt; · Ajustes ao longo do ano (grupos e planilhas)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F5E5A;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="f76"><mxGeometry x="20" y="1970" width="220" height="46" as="geometry"/></mxCell><mxCell id="f147" value="Planilha de ajustes com início/fim de vigência. A IA só sugere a linha a partir da mensagem; uma pessoa aprova" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3DE;strokeColor=#3B6D11;fontColor=#27500A;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="f76"><mxGeometry x="260" y="1970" width="260" height="61" as="geometry"/></mxCell><mxCell id="f148" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888780;" edge="1" parent="f76" source="f146" target="f147"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f149" value="Regra dos gestores: motos +R$5 · leves +R$6 (confirmar nos testes)" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#633806;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="f76"><mxGeometry x="260" y="2041" width="260" height="46" as="geometry"/></mxCell><mxCell id="f150" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888780;" edge="1" parent="f76" source="f146" target="f149"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f151" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444441;" edge="1" parent="f76" source="f136" target="f146"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f152" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444441;" edge="1" parent="1" source="f71" target="f77"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f153" value="5. Vistoria" style="swimlane;startSize=36;fillColor=#E6F1FB;strokeColor=#185FA5;fontColor=#0C447C;fontStyle=1;fontSize=14;rounded=1;arcSize=4;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="2360" y="40" width="540" height="394" as="geometry"/></mxCell><mxCell id="f154" value="&lt;b&gt;29&lt;/b&gt; · Aba &quot;Vistoria&quot;: status e &quot;Visualizar fotos&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F5E5A;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="f153"><mxGeometry x="20" y="56" width="220" height="46" as="geometry"/></mxCell><mxCell id="f155" value="Documentos do card: Termo de Adesão e laudo. CNH, CRLV e comprovante costumam estar nas fotos" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#633806;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="f153"><mxGeometry x="260" y="56" width="260" height="61" as="geometry"/></mxCell><mxCell id="f156" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888780;" edge="1" parent="f153" source="f154" target="f155"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f157" value="&lt;b&gt;30&lt;/b&gt; · Conferir fotos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F5E5A;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="f153"><mxGeometry x="20" y="141" width="220" height="44" as="geometry"/></mxCell><mxCell id="f158" value="Frente, laterais, traseira, motor/km, chassi gravado. Avarias pré-existentes: registrar só periféricos" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#633806;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="f153"><mxGeometry x="260" y="141" width="260" height="61" as="geometry"/></mxCell><mxCell id="f159" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888780;" edge="1" parent="f153" source="f157" target="f158"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f160" value="Assinatura igual à CNH/RG; se divergente, a vistoria precisa de selfie" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#633806;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="f153"><mxGeometry x="260" y="212" width="260" height="46" as="geometry"/></mxCell><mxCell id="f161" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888780;" edge="1" parent="f153" source="f157" target="f160"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f162" value="Critério de aceite das fotos (qualidade mínima)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#F3E8FF;strokeColor=#7F77DD;fontColor=#3C3489;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="f153"><mxGeometry x="260" y="268" width="260" height="46" as="geometry"/></mxCell><mxCell id="f163" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888780;" edge="1" parent="f153" source="f157" target="f162"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f164" value="Checklist automático de fotos obrigatórias + OCR do chassi comparado ao CRLV" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3DE;strokeColor=#3B6D11;fontColor=#27500A;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="f153"><mxGeometry x="260" y="324" width="260" height="46" as="geometry"/></mxCell><mxCell id="f165" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888780;" edge="1" parent="f153" source="f157" target="f164"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f166" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444441;" edge="1" parent="f153" source="f154" target="f157"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f167" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444441;" edge="1" parent="1" source="f146" target="f154"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f168" value="6. Decisão (analista)" style="swimlane;startSize=36;fillColor=#E6F1FB;strokeColor=#185FA5;fontColor=#0C447C;fontStyle=1;fontSize=14;rounded=1;arcSize=4;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="2940" y="40" width="540" height="560" as="geometry"/></mxCell><mxCell id="f169" value="Cadastro ok?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F5E5A;fontSize=12;fontStyle=1;" vertex="1" parent="f168"><mxGeometry x="170" y="60" width="200" height="100" as="geometry"/></mxCell><mxCell id="f170" value="&lt;b&gt;31&lt;/b&gt; · Aprovar (botão na aba Vistoria) → exportar ao SGA com a classificação: Nova adesão, Troca de placa, Reativação ou Troca de titularidade" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F5E5A;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="f168"><mxGeometry x="20" y="210" width="230" height="100" as="geometry"/></mxCell><mxCell id="f171" value="&lt;b&gt;32&lt;/b&gt; · Reprovar → motivo padrão do CRM: Falta contrato, Falta vistoria, Falta documentação, Falta rastreador, Fotos da vistoria ruins, Foto do chassi ilegível" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCEBEB;strokeColor=#A32D2D;fontColor=#791F1F;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="f168"><mxGeometry x="290" y="210" width="230" height="100" as="geometry"/></mxCell><mxCell id="f172" value="Sim" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444441;" edge="1" parent="f168" source="f169" target="f170"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f173" value="Não" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444441;" edge="1" parent="f168" source="f169" target="f171"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f174" value="Fase futura: Aprovar com pendência leve (SGA + planilha) e Retornar ao consultor (Atividades + planilha Retornadas)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#F1EFE8;strokeColor=#888780;fontColor=#5F5E5A;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="f168"><mxGeometry x="20" y="340" width="500" height="56" as="geometry"/></mxCell><mxCell id="f175" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888780;" edge="1" parent="f168" source="f169" target="f174"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f176" value="Modo teste (beta): o robô pode trocar tabela/plano e aprovar/reprovar os cards falsos, comparando com o resultado esperado" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3DE;strokeColor=#3B6D11;fontColor=#27500A;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="f168"><mxGeometry x="20" y="420" width="500" height="50" as="geometry"/></mxCell><mxCell id="f177" value="Produção (app.): por enquanto só leitura e relatório. Nunca clicar em &quot;Atender essa negociação&quot; nem exportar card falso ao SGA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCEBEB;strokeColor=#A32D2D;fontColor=#791F1F;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="f168"><mxGeometry x="20" y="490" width="500" height="50" as="geometry"/></mxCell><mxCell id="f178" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444441;" edge="1" parent="1" source="f157" target="f169"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="a" name="2. Arquitetura da automação"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="a1" value="Arquitetura da automação – o que usar em cada etapa" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#0C447C;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="-60" width="900" height="30" as="geometry"/></mxCell><mxCell id="a2" value="Agendador" style="swimlane;startSize=36;fillColor=#E6F1FB;strokeColor=#185FA5;fontColor=#0C447C;fontStyle=1;fontSize=14;rounded=1;arcSize=4;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="270" height="230" as="geometry"/></mxCell><mxCell id="a3" value="Task Scheduler do Windows a cada X min. Reprocessa só card novo ou alterado (ID + hash)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F5E5A;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="a2"><mxGeometry x="15" y="50" width="240" height="165" as="geometry"/></mxCell><mxCell id="a4" value="Coleta – Playwright (Python)" style="swimlane;startSize=36;fillColor=#E6F1FB;strokeColor=#185FA5;fontColor=#0C447C;fontStyle=1;fontSize=14;rounded=1;arcSize=4;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="340" y="40" width="270" height="230" as="geometry"/></mxCell><mxCell id="a5" value="Login com sessão salva · filtro (URL + selo 5) · lista da coluna Vistorias · pula nomes de analista · lê os dados pelas respostas da API (page.on(&quot;response&quot;)) · baixa fotos e PDFs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F5E5A;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="a4"><mxGeometry x="15" y="50" width="240" height="165" as="geometry"/></mxCell><mxCell id="a6" value="Extração de documentos" style="swimlane;startSize=36;fillColor=#E6F1FB;strokeColor=#185FA5;fontColor=#0C447C;fontStyle=1;fontSize=14;rounded=1;arcSize=4;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="640" y="40" width="270" height="230" as="geometry"/></mxCell><mxCell id="a7" value="1º QR Code da CNH-e/CRLV-e (pyzbar) · 2º IA com visão (Claude) classifica o documento e devolve JSON · 3º PaddleOCR para conferir números" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F5E5A;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="a6"><mxGeometry x="15" y="50" width="240" height="165" as="geometry"/></mxCell><mxCell id="a8" value="Validadores de formato" style="swimlane;startSize=36;fillColor=#E6F1FB;strokeColor=#185FA5;fontColor=#0C447C;fontStyle=1;fontSize=14;rounded=1;arcSize=4;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="940" y="40" width="270" height="230" as="geometry"/></mxCell><mxCell id="a9" value="pydantic + regras: dígito do CPF e do Renavam, chassi com 17 caracteres (sem I/O/Q), placa Mercosul/antiga, correções 0↔O, 1↔I" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F5E5A;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="a8"><mxGeometry x="15" y="50" width="240" height="165" as="geometry"/></mxCell><mxCell id="a10" value="Motor de regras (código, sem IA)" style="swimlane;startSize=36;fillColor=#E6F1FB;strokeColor=#185FA5;fontColor=#0C447C;fontStyle=1;fontSize=14;rounded=1;arcSize=4;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1240" y="40" width="270" height="230" as="geometry"/></mxCell><mxCell id="a11" value="Aceitação, preço Dentro/Fora, cota, rastreador, idade, Uber +2%, vencimento 10/25, FIPE = valor protegido, regionais. Comparação de nomes com rapidfuzz" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F5E5A;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="a10"><mxGeometry x="15" y="50" width="240" height="165" as="geometry"/></mxCell><mxCell id="a12" value="Banco de dados" style="swimlane;startSize=36;fillColor=#E6F1FB;strokeColor=#185FA5;fontColor=#0C447C;fontStyle=1;fontSize=14;rounded=1;arcSize=4;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1540" y="40" width="270" height="230" as="geometry"/></mxCell><mxCell id="a13" value="SQLite → PostgreSQL. Tabelas: cards, snapshots (JSON bruto), documentos, extracoes, tabela_aceitacao, tabela_precos (com vigência), regras, validacoes, execucoes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F5E5A;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="a12"><mxGeometry x="15" y="50" width="240" height="165" as="geometry"/></mxCell><mxCell id="a14" value="Relatório para a analista" style="swimlane;startSize=36;fillColor=#E6F1FB;strokeColor=#185FA5;fontColor=#0C447C;fontStyle=1;fontSize=14;rounded=1;arcSize=4;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1840" y="40" width="270" height="230" as="geometry"/></mxCell><mxCell id="a15" value="Por card: ✅ OK / ❌ divergente (esperado × encontrado) / ⚠️ não verificável. A decisão continua com a analista" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F5E5A;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="a14"><mxGeometry x="15" y="50" width="240" height="165" as="geometry"/></mxCell><mxCell id="a16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444441;" edge="1" parent="1" source="a2" target="a4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444441;" edge="1" parent="1" source="a4" target="a6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444441;" edge="1" parent="1" source="a6" target="a8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444441;" edge="1" parent="1" source="a8" target="a10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444441;" edge="1" parent="1" source="a10" target="a12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444441;" edge="1" parent="1" source="a12" target="a14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a22" value="Base de regras: BASE REGRAS ROBO CADASTRO.xlsx (tabelas do CRM, escolha da tabela, regional, ajustes com vigência, exceções, casos de teste) + Tabela de Aceitação 22/05/2026 + tabelas Dentro/Fora" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#633806;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="940" y="330" width="520" height="80" as="geometry"/></mxCell><mxCell id="a23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444441;" edge="1" parent="1" source="a22" target="a10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a24" value="Proteção: no beta grava só nos cards da lista de teste; em produção o robô cancela qualquer POST/PUT/DELETE (page.route)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCEBEB;strokeColor=#A32D2D;fontColor=#791F1F;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="340" y="330" width="520" height="60" as="geometry"/></mxCell><mxCell id="a25" value="IA SIM: ler documentos e fotos, classificar o tipo de documento, comparar nomes de modelo diferentes, escrever o resumo das divergências" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3DE;strokeColor=#3B6D11;fontColor=#27500A;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="620" height="50" as="geometry"/></mxCell><mxCell id="a26" value="IA NÃO: calcular mensalidade, cota, faixa de valor e prazos (isso é código determinístico e rastreável até a linha da tabela)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCEBEB;strokeColor=#A32D2D;fontColor=#791F1F;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="700" y="450" width="620" height="50" as="geometry"/></mxCell><mxCell id="a27" value="LGPD: CNH, CPF e fotos só no seu servidor, criptografados, com prazo de retenção. Provedor de IA com contrato que não treina com os dados" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#633806;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1360" y="450" width="620" height="50" as="geometry"/></mxCell><mxCell id="a28" value="Ordem: 1) tabelas de preço em CSV · 2) criar os 20 cards falsos no beta (aba CASOS_TESTE) · 3) Playwright lendo os cards · 4) regras de escolha da tabela e preço · 5) documentos/OCR · 6) relatório · 7) só depois produção" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#F3E8FF;strokeColor=#7F77DD;fontColor=#3C3489;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="1280" height="44" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d" name="3. Decisões e pendências"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="d1" value="Decisões tomadas e o que ainda está em aberto" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#0C447C;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="-60" width="1000" height="30" as="geometry"/></mxCell><mxCell id="d2" value="Resolvido" style="swimlane;startSize=36;fillColor=#E6F1FB;strokeColor=#185FA5;fontColor=#0C447C;fontStyle=1;fontSize=14;rounded=1;arcSize=4;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="400" height="608" as="geometry"/></mxCell><mxCell id="d3" value="BYD King = FLAT (segue a tabela) · Geely EX5 = ESPECIAL (segue o DOC)" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#633806;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="d2"><mxGeometry x="20" y="50" width="360" height="46" as="geometry"/></mxCell><mxCell id="d4" value="Moto 50cc Shineray/SBM/Avelloz: só aceita emplacada" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#633806;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="d2"><mxGeometry x="20" y="106" width="360" height="44" as="geometry"/></mxCell><mxCell id="d5" value="Mais de 20 anos: FLAT com autorização da diretoria" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#633806;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="d2"><mxGeometry x="20" y="160" width="360" height="44" as="geometry"/></mxCell><mxCell id="d6" value="Commander, Territory, Fusion 2013+: tabelas próprias no CRM (13–16)" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#633806;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="d2"><mxGeometry x="20" y="214" width="360" height="46" as="geometry"/></mxCell><mxCell id="d7" value="Tabelas Dentro/Fora (VALLE) são vigentes e valem para ANCORE, VALLE, Protege Car e outras" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#633806;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="d2"><mxGeometry x="20" y="270" width="360" height="46" as="geometry"/></mxCell><mxCell id="d8" value="+R$5 motos / +R$6 leves: regra dos gestores, salva como ajuste" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#633806;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="d2"><mxGeometry x="20" y="326" width="360" height="46" as="geometry"/></mxCell><mxCell id="d9" value="CG 160 = faixa 151–160cc (vale o nome do modelo)" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#633806;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="d2"><mxGeometry x="20" y="382" width="360" height="44" as="geometry"/></mxCell><mxCell id="d10" value="Interior de GO = FORA · Dentro = 21 cidades" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#633806;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="d2"><mxGeometry x="20" y="436" width="360" height="44" as="geometry"/></mxCell><mxCell id="d11" value="Filiação não é conferida · câmbio não altera valores" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#633806;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="d2"><mxGeometry x="20" y="490" width="360" height="44" as="geometry"/></mxCell><mxCell id="d12" value="Uber e diesel mudam a TABELA; só a cota muda" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FAEEDA;strokeColor=#854F0B;fontColor=#633806;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="d2"><mxGeometry x="20" y="544" width="360" height="44" as="geometry"/></mxCell><mxCell id="d13" value="Guardado para depois" style="swimlane;startSize=36;fillColor=#E6F1FB;strokeColor=#185FA5;fontColor=#0C447C;fontStyle=1;fontSize=14;rounded=1;arcSize=4;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="460" y="40" width="400" height="226" as="geometry"/></mxCell><mxCell id="d14" value="Aplicativo nas faixas de cota fixa (ex.: carro até R$20 mil)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#F1EFE8;strokeColor=#888780;fontColor=#5F5E5A;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="d13"><mxGeometry x="20" y="50" width="360" height="46" as="geometry"/></mxCell><mxCell id="d15" value="Cota de moto de aplicativo" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#F1EFE8;strokeColor=#888780;fontColor=#5F5E5A;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="d13"><mxGeometry x="20" y="106" width="360" height="44" as="geometry"/></mxCell><mxCell id="d16" value="Retornadas / pendências / período por data de atualização" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#F1EFE8;strokeColor=#888780;fontColor=#5F5E5A;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="d13"><mxGeometry x="20" y="160" width="360" height="46" as="geometry"/></mxCell><mxCell id="d17" value="A confirmar" style="swimlane;startSize=36;fillColor=#E6F1FB;strokeColor=#185FA5;fontColor=#0C447C;fontStyle=1;fontSize=14;rounded=1;arcSize=4;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="880" y="40" width="400" height="338" as="geometry"/></mxCell><mxCell id="d18" value="Estados &quot;+1% em cima da tabela&quot;: como aparece no CRM (PE e SP FORA 